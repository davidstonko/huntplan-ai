# MDHuntFishOutdoors — environment template
# Copy this file to `.env` (which is gitignored) and fill in your own
# values. Never commit `.env`.
#
# Created 2026-05-01 (V2.4 audit, iter 8). The src/config.ts dotenv
# loader expects MAPBOX_ACCESS_TOKEN at minimum; the rest are
# optional overrides that default to the production values.

# Mapbox public token — required at build time. Get yours at
# https://account.mapbox.com/access-tokens/. Token must have at
# minimum the styles:read + tiles:read scopes.
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# Optional: point at a local backend during dev. Defaults to the
# Render production URL when unset (see src/config.ts API_BASE_URL).
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Optional: RevenueCat API key for subscription features. App falls
# back gracefully when unset (purchaseService.ts handles missing SDK).
# REVENUECAT_API_KEY=appl_your_revenuecat_key_here

# Optional: Sentry DSN for crash reporting. App falls back gracefully
# when unset (sentryClient.ts no-ops without DSN).
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
